<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Status Header -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Service Active"
            android:textColor="#34C759"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <!-- Permission Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accessibility service is disabled. Turn it on to track physical button presses."
                    android:textColor="#FF9F0A"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPerm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enable in Accessibility" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Edge Test Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#161618">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Screen Test"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hold down to preview the squeeze effect live on your screen edge."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHoldTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hold to Test Bezel Squeeze" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shape & Appearance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#161618">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shape &amp; Appearance"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerShape"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenDraw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Open Drawing Canvas"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <View
                        android:id="@+id/colorPreview"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#000000" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickColor"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Change Bezel Color" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Button Layout Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#161618">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Button Layout"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchRightEdge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Buttons on Right Edge" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchUnified"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Unified Single Volume Bar" />

                <!-- Unified Slider -->
                <LinearLayout
                    android:id="@+id/boxUnified"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvRockerLen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Bar Length: 380 px"
                        android:textColor="#CCCCCC" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRockerLen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="100"
                        android:valueTo="900"
                        android:stepSize="10"
                        android:value="380" />
                </LinearLayout>

                <!-- Split Slider -->
                <LinearLayout
                    android:id="@+id/boxSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSingleLen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Separate Button Length: 160 px"
                        android:textColor="#CCCCCC" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSingleLen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="60"
                        android:valueTo="500"
                        android:stepSize="10"
                        android:value="160" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Position & Size Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#161618">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Position &amp; Size"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Volume Up Y -->
                <TextView
                    android:id="@+id/tvVolUpY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Volume Up Height: 720 px"
                    android:textColor="#CCCCCC" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderVolUpY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="100"
                    android:valueTo="2400"
                    android:stepSize="10"
                    android:value="720" />

                <!-- Volume Down Y -->
                <TextView
                    android:id="@+id/tvVolDownY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Volume Down Height: 960 px"
                    android:textColor="#CCCCCC" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderVolDownY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="100"
                    android:valueTo="2400"
                    android:stepSize="10"
                    android:value="960" />

                <!-- Bulge Depth -->
                <TextView
                    android:id="@+id/tvDepth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bulge Depth: 40 px"
                    android:textColor="#CCCCCC" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDepth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="10"
                    android:valueTo="180"
                    android:stepSize="2"
                    android:value="40" />

                <!-- Speed -->
                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Inward Speed: 85 ms"
                    android:textColor="#CCCCCC" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="20"
                    android:valueTo="300"
                    android:stepSize="5"
                    android:value="85" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Extra Hardware Key Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#161618">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extra Hardware Button"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExtraKeyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No extra button mapped."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Map Extra Button" />

                <TextView
                    android:id="@+id/tvExtraY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Extra Button Height: 500 px"
                    android:textColor="#CCCCCC" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderExtraY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="100"
                    android:valueTo="2400"
                    android:stepSize="10"
                    android:value="500" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
